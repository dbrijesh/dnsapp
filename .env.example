# Django Settings
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Settings
# For local development, leave these empty to use SQLite
# For production with Azure SQL, set USE_AZURE_SQL=True and provide connection details
USE_AZURE_SQL=False
AZURE_SQL_SERVER=your-server.database.windows.net
AZURE_SQL_DATABASE=your-database-name
AZURE_SQL_USER=your-username
AZURE_SQL_PASSWORD=your-password

# Azure Blob Storage
# For local development, leave USE_AZURE_STORAGE=False to use local file storage
# For production, set USE_AZURE_STORAGE=True and provide connection string
USE_AZURE_STORAGE=False
AZURE_STORAGE_CONNECTION_STRING=your-azure-storage-connection-string
AZURE_STORAGE_CONTAINER_NAME=course-materials

# Azure AD SSO (Optional)
# For local development, leave USE_AZURE_AD_SSO=False to use local authentication
# For production SSO, set USE_AZURE_AD_SSO=True and provide Azure AD details
USE_AZURE_AD_SSO=False
AZURE_AD_CLIENT_ID=your-client-id
AZURE_AD_CLIENT_SECRET=your-client-secret
AZURE_AD_TENANT_ID=your-tenant-id
AZURE_AD_REDIRECT_URI=https://your-app.azurecontainerapps.io/accounts/auth/callback
